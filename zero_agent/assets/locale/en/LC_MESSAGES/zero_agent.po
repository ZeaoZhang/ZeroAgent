msgid "prompt.reply_language"
msgstr "Reply in the language the user is currently using unless they explicitly request another."

msgid "prompt.task_control.open"
msgstr ""
"<task_control state=\"open\">\n"
"When no tools are needed, provide the complete final answer directly. Use tools for external facts or actions; "
"the runtime updates task state.\n"
"</task_control>"

msgid "prompt.task_control.executing"
msgstr ""
"<task_control state=\"executing\">\n"
"When complete, call `complete_task`; follow its tools schema to provide `answer` and cite successful "
"`evidence_refs` from this task. Do not finish with plain text.\n"
"</task_control>"

msgid "prompt.task_control.plan"
msgstr ""
"<task_control state=\"plan\">\n"
"Call `complete_task` only after both the plan checklist and verification gate pass. Otherwise continue, "
"or call `ask_user` when the gate requires a user decision.\n"
"</task_control>"

msgid "prompt.today_label"
msgstr "Today:"

msgid "prompt.peer_hint"
msgstr "[Peer] When the user mentions other sessions or background task status: temp/model_responses/ (only inspect the tails of recently modified files)"

