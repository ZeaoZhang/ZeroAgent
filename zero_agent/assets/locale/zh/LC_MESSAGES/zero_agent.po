msgid "prompt.reply_language"
msgstr "使用用户当前使用的语言回复，除非用户明确指定其他语言。"

msgid "prompt.task_control.open"
msgstr ""
"<task_control state=\"open\">\n"
"无需工具即可完整回答时可直接给出最终答复。需要外部事实或操作时调用工具；"
"任务状态由运行时更新。\n"
"</task_control>"

msgid "prompt.task_control.executing"
msgstr ""
"<task_control state=\"executing\">\n"
"完成时必须调用 `complete_task`，按其 tools schema 提供 `answer` 并引用当前任务中的成功 `evidence_refs`；"
"不得以普通文本结束。\n"
"</task_control>"

msgid "prompt.task_control.plan"
msgstr ""
"<task_control state=\"plan\">\n"
"只有计划清单与验证门控均通过后才能调用 `complete_task`；"
"否则继续执行，或按门控要求调用 `ask_user` 请求用户决定。\n"
"</task_control>"

msgid "prompt.today_label"
msgstr "今天："

msgid "prompt.peer_hint"
msgstr "[Peer] 用户提及其他会话/后台任务状态时: temp/model_responses/ (只找近期修改的文件尾部)"

msgid "prompt.file_delivery"
msgstr "发送图片等文件时，请在最终回复中加入 [FILE:相对路径]；仅提及路径不算发送。"

msgid "weekday.monday"
msgstr "周一"

